or-element.elementor-element-32edabe img{width:56%;}.elementor-10 .elementor-element.elementor-element-ca7603f{--gap:0px 0px;--row-gap:0px;--column-gap:0px;--padding-top:30px;--padding-bottom:30px;--padding-left:20px;--padding-right:20px;}.elementor-10 .elementor-element.elementor-element-9cbd0c7{text-align:center;}.elementor-10 .elementor-element.elementor-element-9cbd0c7 .elementor-heading-title{font-size:17px;}.elementor-10 .elementor-element.elementor-element-d38128c{width:var( --container-widget-width, 44% );max-width:44%;--container-widget-width:44%;--container-widget-flex-grow:0;}.elementor-10 .elementor-element.elementor-element-d38128c img{width:62%;}}/* Start custom CSS for nested-carousel, class: .elementor-element-fe573a2 *//* =========================================================
   DESTINATION CARD — PREMIUM TRAVEL HOVER
   NO IMAGE ZOOM
========================================================= */

.destination-card {
    cursor: pointer !important;
    overflow: hidden !important;

    background-position: center center !important;
    background-size: cover !important;

    transition:
        transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.55s ease !important;

    /* Subtle normal shadow */
    box-shadow:
        0 8px 20px rgba(0, 0, 0, 0.10) !important;
}


/* =========================================================
   HOVER — CARD LIFT + SHADOW
========================================================= */

.destination-card:hover {

    transform: translateY(-4px) !important;

    box-shadow:
        0 10px 25px rgba(0, 0, 0, 0.18),
        0 25px 45px rgba(0, 0, 0, 0.22) !important;
}


/* =========================================================
   BOTTOM BLACK SPREAD
========================================================= */

.destination-card {
    box-shadow:
        inset 0 -150px 100px -70px rgba(0, 0, 0, 0.72),
        0 8px 20px rgba(0, 0, 0, 0.10) !important;
}


.destination-card:hover {
    box-shadow:
        inset 0 -190px 120px -60px rgba(0, 0, 0, 0.88),
        0 10px 25px rgba(0, 0, 0, 0.18),
        0 25px 45px rgba(0, 0, 0, 0.22) !important;
}


/* =========================================================
   ALL HEADINGS INSIDE CARD
========================================================= */

.destination-card .elementor-heading-title {

    transition:
        color 0.5s ease,
        text-shadow 0.5s ease,
        transform 0.5s ease !important;
}


/* =========================================================
   TITLE BECOMES RED ON HOVER
========================================================= */

.destination-card:hover .elementor-heading-title {

    color: #B33A2C !important;

    text-shadow:
        0 2px 8px rgba(0, 0, 0, 0.65) !important;
}


/* =========================================================
   VIEW DESTINATION
========================================================= */

.destination-card a {

    transition:
        color 0.45s ease,
        opacity 0.45s ease,
        letter-spacing 0.45s ease,
        text-shadow 0.45s ease !important;
}


.destination-card:hover a {

    color: #EDE7DA !important;

    opacity: 1 !important;

    letter-spacing: 0.035em !important;

    text-shadow:
        0 2px 8px rgba(0, 0, 0, 0.75) !important;
}


/* =========================================================
   TEXT EDITOR / DESCRIPTION
========================================================= */

.destination-card .elementor-widget-text-editor {

    transition:
        opacity 0.45s ease,
        text-shadow 0.45s ease !important;
}


.destination-card:hover .elementor-widget-text-editor {

    opacity: 1 !important;

    text-shadow:
        0 2px 8px rgba(0, 0, 0, 0.75) !important;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1024px) {

    .destination-card:hover {

        transform: translateY(-2px) !important;

        box-shadow:
            inset 0 -160px 100px -65px rgba(0, 0, 0, 0.82),
            0 12px 28px rgba(0, 0, 0, 0.18) !important;
    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 767px) {

    .destination-card:hover {

        transform: translateY(-2px) !important;

        box-shadow:
            inset 0 -150px 90px -65px rgba(0, 0, 0, 0.82),
            0 8px 20px rgba(0, 0, 0, 0.16) !important;
    }

}


/* =========================================================
   REDUCE MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    .destination-card,
    .destination-card .elementor-heading-title,
    .destination-card a,
    .destination-card .elementor-widget-text-editor {

        transition: none !important;
    }

}/* End custom CSS */
/* Start custom CSS for container, class: .elementor-element-9cd8813 *//* Crop the bottom of the widget container to hide the badge */
#shapo-widget-f1a8d2d1a4889866254a {
    max-height: 620px !important; /* Forces the box shorter */
    overflow: hidden !important;   /* Cuts off anything below 480px */
}

#shapo-widget-f1a8d2d1a4889866254a iframe {
    max-height: 620px !important;
    overflow: hidden !important;
