{"meta": {"_elementor_data": "[{\"id\": \"26d562e\", \"elType\": \"container\", \"settings\": {\"content_width\": \"full\", \"css_classes\": \"cc-wrap\", \"padding\": {\"unit\": \"px\", \"top\": \"0\", \"right\": \"0\", \"bottom\": \"0\", \"left\": \"0\", \"isLinked\": true}, \"flex_gap\": {\"unit\": \"px\", \"size\": 0, \"column\": \"0\", \"row\": \"0\"}}, \"elements\": [{\"id\": \"0c84154\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<div class=\\\"cc cc-page\\\"><div class=\\\"hero\\\">\\n  <img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-hero.webp\\\" alt=\\\"Four Cigala Cycling riders climbing together in team kit\\\" width=\\\"1600\\\" height=\\\"1082\\\">\\n  <div class=\\\"in\\\">\\n    <h2 class=\\\"eyebrow-h\\\">#TrainSmarterRideFaster</h2>\\n    <h1>Premium Cycling &amp; Triathlon Coaching</h1>\\n    <p class=\\\"lede\\\">Personalised training plans, expert feedback and support from Head Coach Matteo Cigala, on TrainingPeaks and Vekta.</p>\\n    <div class=\\\"ctas\\\">\\n      <a class=\\\"btn btn-go\\\" href=\\\"/individual-packages/\\\">Cycling coaching \\u2192</a>\\n      <a class=\\\"btn btn-ghost\\\" href=\\\"/tri-individual-packages/\\\">Triathlon coaching</a>\\n    </div>\\n  </div>\\n</div></div>\"}, \"elements\": [], \"isInner\": false}], \"isInner\": false}, {\"id\": \"e1334b1\", \"elType\": \"container\", \"settings\": {\"content_width\": \"full\", \"css_classes\": \"cc-wrap\", \"padding\": {\"unit\": \"px\", \"top\": \"0\", \"right\": \"0\", \"bottom\": \"0\", \"left\": \"0\", \"isLinked\": true}, \"flex_gap\": {\"unit\": \"px\", \"size\": 0, \"column\": \"0\", \"row\": \"0\"}}, \"elements\": [{\"id\": \"1ea7155\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<div class=\\\"cc cc-page\\\"><div class=\\\"in stats-wrap\\\">\\n  <div class=\\\"stats\\\">\\n    <div class=\\\"stat\\\"><div class=\\\"n\\\">28</div><div class=\\\"l\\\">Years of racing</div></div>\\n    <div class=\\\"stat\\\"><div class=\\\"n\\\">200+</div><div class=\\\"l\\\">Race victories</div></div>\\n    <div class=\\\"stat\\\"><div class=\\\"n\\\">1-to-1</div><div class=\\\"l\\\">Sessions in Wicklow</div></div>\\n    <div class=\\\"stat\\\"><div class=\\\"n\\\">Worldwide</div><div class=\\\"l\\\">Remote coaching</div></div>\\n  </div>\\n</div></div>\"}, \"elements\": [], \"isInner\": false}], \"isInner\": false}, {\"id\": \"a63e534\", \"elType\": \"container\", \"settings\": {\"content_width\": \"full\", \"css_classes\": \"cc-wrap\", \"padding\": {\"unit\": \"px\", \"top\": \"0\", \"right\": \"0\", \"bottom\": \"0\", \"left\": \"0\", \"isLinked\": true}, \"flex_gap\": {\"unit\": \"px\", \"size\": 0, \"column\": \"0\", \"row\": \"0\"}}, \"elements\": [{\"id\": \"4d6b227\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<div class=\\\"cc cc-page\\\"><section id=\\\"coaching\\\">\\n  <div class=\\\"in\\\">\\n    <div class=\\\"head\\\"><div>\\n      <div class=\\\"eyebrow\\\">Cycling &amp; triathlon</div>\\n      <h2>ITALIAN PERFORMANCE COACHING FOR CYCLISTS AND TRIATHLETES WORLDWIDE</h2>\\n      <div class=\\\"bar\\\"></div>\\n      <p class=\\\"lede\\\">Personalised coaching from Italian Head Coach Matteo Cigala, combining over 20 years of racing experience, sports science, and professional coaching methods to help cyclists and triathletes in Ireland and worldwide improve performance and reach their goals.</p>\\n    </div></div>\\n    <div class=\\\"paths\\\">\\n      <a class=\\\"path\\\" href=\\\"/individual-packages/\\\">\\n        <img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-cycling-coaching.webp\\\" alt=\\\"Cyclist riding a quiet country road\\\" loading=\\\"lazy\\\" width=\\\"1067\\\" height=\\\"1600\\\">\\n        <div class=\\\"tx\\\"><h3>CYCLING COACHING</h3><p>Road, gravel and Gran Fondo. Individual, group and club packages.</p><span class=\\\"go\\\">View cycling packages \\u2192</span></div>\\n      </a>\\n      <a class=\\\"path\\\" href=\\\"/tri-individual-packages/\\\">\\n        <img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-triathlon-coaching.webp\\\" alt=\\\"Triathlete standing by a lake at sunrise\\\" loading=\\\"lazy\\\" width=\\\"1600\\\" height=\\\"1200\\\">\\n        <div class=\\\"tx\\\"><h3>triathlon COACHING</h3><p>Swim, bike and run, from Sprint to Ironman.</p><span class=\\\"go\\\">View triathlon packages \\u2192</span></div>\\n      </a>\\n    </div>\\n  </div>\\n</section></div>\"}, \"elements\": [], \"isInner\": false}], \"isInner\": false}, {\"id\": \"34c0ad8\", \"elType\": \"container\", \"settings\": {\"content_width\": \"full\", \"css_classes\": \"cc-wrap\", \"padding\": {\"unit\": \"px\", \"top\": \"0\", \"right\": \"0\", \"bottom\": \"0\", \"left\": \"0\", \"isLinked\": true}, \"flex_gap\": {\"unit\": \"px\", \"size\": 0, \"column\": \"0\", \"row\": \"0\"}}, \"elements\": [{\"id\": \"778bad4\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<div class=\\\"cc cc-page\\\"><section class=\\\"offer\\\">\\n  <div class=\\\"in split\\\">\\n    <div class=\\\"photo\\\"><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-what-we-offer.webp\\\" alt=\\\"Cyclist finishing the Gran Fondo Strade Bianche in Siena\\\" loading=\\\"lazy\\\" width=\\\"1600\\\" height=\\\"1066\\\"></div>\\n    <div>\\n      <div class=\\\"eyebrow\\\">Why Cigala Cycling</div>\\n      <h3 class=\\\"h-sec\\\">WHAT WE OFFER</h3>\\n      <div class=\\\"bar\\\"></div>\\n      <p class=\\\"first\\\">Cigala Cycling provides premium cycling and triathlon coaching for all levels of cyclist, from leisure to professional.<br>\\nNo matter where you are in the world, we coach remotely in different countries, developing customised coaching plans to suit your needs.</p>\\n      <p>Cigala Cycling was founded by Italian Head Coach Matteo Cigala, that with over 20 years experience in cycling, hundreds of victories in his name and a Diploma in Science and Sport, had a vision of connecting Ireland to the Italian cycling scene, bringing the most advanced and up-to date coaching through his continuous collaboration with Italian professional cyclists and coaches.</p>\\n      <p>With Cigala Cycling Tours we also hold Bike Tours all over Europe such as Lake Garda in Italy, the Algarve in Portugal and in the Italian Alps, French Alps, Pyrenees, Croatia and much more</p>\\n      <div class=\\\"ctas\\\"><a class=\\\"btn btn-ghost\\\" href=\\\"/coaching-vision/\\\">Our coaching vision \\u2192</a></div>\\n    </div>\\n  </div>\\n</section></div>\"}, \"elements\": [], \"isInner\": false}], \"isInner\": false}, {\"id\": \"15bebd4\", \"elType\": \"container\", \"settings\": {\"content_width\": \"full\", \"css_classes\": \"cc-wrap\", \"padding\": {\"unit\": \"px\", \"top\": \"0\", \"right\": \"0\", \"bottom\": \"0\", \"left\": \"0\", \"isLinked\": true}, \"flex_gap\": {\"unit\": \"px\", \"size\": 0, \"column\": \"0\", \"row\": \"0\"}}, \"elements\": [{\"id\": \"563a1c4\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<div class=\\\"cc cc-page\\\"><section class=\\\"matteo\\\">\\n  <div class=\\\"in split flip\\\">\\n    <div>\\n      <div class=\\\"eyebrow\\\">Meet your coach</div>\\n      <h3 class=\\\"h-sec\\\">MATTEO CIGALA</h3>\\n      <div class=\\\"bar\\\"></div>\\n      <p class=\\\"role\\\">Head Coach &amp; Tours Director \\u00b7 28 years in cycling</p>\\n      <ul class=\\\"creds\\\">\\n        <li>European Road Champion Gran Fondo</li>\\n        <li>UCI Gran Fondo Vice World Champion</li>\\n        <li>UCI Gravel Vice World Champion</li>\\n        <li>Italian Gravel Champion</li>\\n      </ul>\\n      <div class=\\\"ctas\\\"><a class=\\\"btn btn-ghost\\\" href=\\\"/about/\\\">About Matteo \\u2192</a><a class=\\\"arrow-link\\\" href=\\\"/testimonials/\\\">Read our testimonials \\u2192</a></div>\\n    </div>\\n    <div class=\\\"photo\\\"><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-matteo.webp\\\" alt=\\\"Matteo Cigala, Head Coach, in the white Cigala Cycling jersey\\\" loading=\\\"lazy\\\"></div>\\n  </div>\\n</section></div>\"}, \"elements\": [], \"isInner\": false}], \"isInner\": false}, {\"id\": \"9d359df\", \"elType\": \"container\", \"settings\": {\"content_width\": \"full\", \"css_classes\": \"cc-wrap\", \"padding\": {\"unit\": \"px\", \"top\": \"0\", \"right\": \"0\", \"bottom\": \"0\", \"left\": \"0\", \"isLinked\": true}, \"flex_gap\": {\"unit\": \"px\", \"size\": 0, \"column\": \"0\", \"row\": \"0\"}}, \"elements\": [{\"id\": \"88e88ec\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<div class=\\\"cc cc-page\\\"><section id=\\\"tours\\\">\\n  <div class=\\\"in\\\">\\n    <div class=\\\"head\\\">\\n      <div>\\n        <div class=\\\"eyebrow\\\">Ride with us</div>\\n        <h3 class=\\\"h-sec\\\">CYCLING TOURS</h3>\\n        <div class=\\\"bar\\\"></div>\\n        <p class=\\\"lede\\\">With the partner company, Cigala Cycling Tours, we have selected the most beautiful cycling locations in Europe with a rich heritage, local culture and cuisine and combined them with amazing cycling routes to ensure that your vacation will be truly unforgettable.</p>\\n      </div>\\n      <a class=\\\"arrow-link\\\" href=\\\"https://tours.cigalacycling.com/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Visit Cigala Cycling Tours \\u2192</a>\\n    </div>\\n    <div class=\\\"dests\\\">\\n      <a class=\\\"dest\\\" href=\\\"https://tours.cigalacycling.com/destinations/algarve/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\"><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-algarve.webp\\\" alt=\\\"Cycling in The Algarve, Portugal\\\" loading=\\\"lazy\\\" width=\