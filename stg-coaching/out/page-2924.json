g.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-costa-blanca.webp\\\" alt=\\\"Cycling in Costa Blanca, Spain\\\" loading=\\\"lazy\\\" width=\\\"400\\\" height=\\\"300\\\"><h4 class=\\\"dest-h\\\">COSTA BLANCA, SPAIN</h4></a>\\n      <a class=\\\"dest\\\" href=\\\"https://tours.cigalacycling.com/destinations/slovenia/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\"><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-slovenia.webp\\\" alt=\\\"Cycling in Slovenia\\\" loading=\\\"lazy\\\" width=\\\"400\\\" height=\\\"300\\\"><h4 class=\\\"dest-h\\\">SLOVENIA</h4></a>\\n      <a class=\\\"dest\\\" href=\\\"https://tours.cigalacycling.com/destinations/cyprus/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\"><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-cyprus.webp\\\" alt=\\\"Cycling in Cyprus\\\" loading=\\\"lazy\\\" width=\\\"400\\\" height=\\\"300\\\"><h4 class=\\\"dest-h\\\">CYPRUS</h4></a>\\n      <a class=\\\"dest\\\" href=\\\"https://tours.cigalacycling.com/destinations/croatia/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\"><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-croatia.webp\\\" alt=\\\"Cycling in Croatia\\\" loading=\\\"lazy\\\" width=\\\"400\\\" height=\\\"300\\\"><h4 class=\\\"dest-h\\\">CROATIA</h4></a>\\n      <a class=\\\"dest\\\" href=\\\"https://tours.cigalacycling.com/destinations/ireland/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\"><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-ireland.webp\\\" alt=\\\"Cycling in Ireland\\\" loading=\\\"lazy\\\" width=\\\"400\\\" height=\\\"300\\\"><h2 class=\\\"dest-h\\\">IRELAND</h2></a>\\n    </div>\\n  </div>\\n</section></div>\"}, \"elements\": [], \"isInner\": false}], \"isInner\": false}, {\"id\": \"547c03e\", \"elType\": \"container\", \"settings\": {\"content_width\": \"full\", \"css_classes\": \"cc-wrap\", \"padding\": {\"unit\": \"px\", \"top\": \"0\", \"right\": \"0\", \"bottom\": \"0\", \"left\": \"0\", \"isLinked\": true}, \"flex_gap\": {\"unit\": \"px\", \"size\": 0, \"column\": \"0\", \"row\": \"0\"}}, \"elements\": [{\"id\": \"9eec2fe\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<div class=\\\"cc cc-page\\\"><section>\\n  <div class=\\\"in\\\">\\n    <div class=\\\"band\\\">\\n      <img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-retail.webp\\\" alt=\\\"Cyclist training on an indoor smart trainer in a garage\\\" loading=\\\"lazy\\\" width=\\\"1600\\\" height=\\\"872\\\">\\n      <div class=\\\"tx\\\">\\n        <div class=\\\"eyebrow eb-pill\\\"><span></span>Cigala Cycling Retail</div>\\n        <h2>SUPPLIERS OF PREMIUM BRANDS</h2>\\n        <div class=\\\"bar\\\"></div>\\n        <div class=\\\"ctas\\\"><h3 class=\\\"btn-h\\\"><a class=\\\"btn btn-go\\\" href=\\\"https://retail.cigalacycling.com/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">VISIT OUR RETAIL SITE</a></h3></div>\\n      </div>\\n    </div>\\n  </div>\\n</section></div>\"}, \"elements\": [], \"isInner\": false}], \"isInner\": false}, {\"id\": \"e79b063\", \"elType\": \"container\", \"settings\": {\"content_width\": \"full\", \"css_classes\": \"cc-wrap\", \"padding\": {\"unit\": \"px\", \"top\": \"0\", \"right\": \"0\", \"bottom\": \"0\", \"left\": \"0\", \"isLinked\": true}, \"flex_gap\": {\"unit\": \"px\", \"size\": 0, \"column\": \"0\", \"row\": \"0\"}}, \"elements\": [{\"id\": \"d049ef8\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<div class=\\\"cc cc-page\\\"><section>\\n  <div class=\\\"in decade\\\">\\n    <img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-over-a-decade.webp\\\" alt=\\\"Over a decade of dedication, expertise and results: athletes coached by Cigala Cycling\\\" loading=\\\"lazy\\\" width=\\\"1000\\\" height=\\\"562\\\">\\n  </div>\\n</section></div>\"}, \"elements\": [], \"isInner\": false}], \"isInner\": false}, {\"id\": \"130424f\", \"elType\": \"container\", \"settings\": {\"content_width\": \"full\", \"css_classes\": \"cc-wrap\", \"padding\": {\"unit\": \"px\", \"top\": \"0\", \"right\": \"0\", \"bottom\": \"0\", \"left\": \"0\", \"isLinked\": true}, \"flex_gap\": {\"unit\": \"px\", \"size\": 0, \"column\": \"0\", \"row\": \"0\"}}, \"elements\": [{\"id\": \"e583afc\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<div class=\\\"cc cc-page\\\"><section id=\\\"reviews\\\">\\n  <div class=\\\"in\\\">\\n    <div class=\\\"head\\\">\\n      <div><div class=\\\"eyebrow\\\">Our athletes</div><h3 class=\\\"h-sec\\\">WHAT OUR ATHLETES SAY</h3><div class=\\\"bar\\\"></div></div>\\n      <div class=\\\"rv-links\\\"><a class=\\\"arrow-link\\\" href=\\\"https://share.google/lwboSfcuStGhX0c0p\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">\\u2605 Read our reviews on Google \\u2192</a><a class=\\\"arrow-link\\\" href=\\\"/testimonials/\\\">All testimonials \\u2192</a></div>\\n    </div>\\n    <div class=\\\"rv-wrap\\\"><div class=\\\"rv-row\\\" id=\\\"rv-row\\\" tabindex=\\\"0\\\" aria-label=\\\"Athlete reviews, scroll sideways\\\"><figure class=\\\"rv\\\"><div class=\\\"rv-tag\\\">Gran Fondo Worlds qualifier</div><blockquote>\\u201cWith his expertise, support, and personalized approach, I have achieved my goal of qualifying for the UCI Granfondo World Championship.\\u201d</blockquote><figcaption><b>Bernd Ondruch</b><span>Germany</span></figcaption></figure><figure class=\\\"rv\\\"><div class=\\\"rv-tag\\\">From couch to Haute Route, and back after heart disease</div><blockquote>\\u201cFirst time was a 9 month training plan to get me from couch (literally!) to Haute Route Pyrenees in 2017 to mark my 60th birthday. More recently, I have worked with Matteo to help me recover from heart disease and a cardiac procedure.\\u201d</blockquote><figcaption><b>Derek Lawler</b><span>Kilkenny, Ireland</span></figcaption></figure><figure class=\\\"rv\\\"><div class=\\\"rv-tag\\\">Mallorca 312 in the best shape ever</div><blockquote>\\u201cI truly had a tailor-made plan every single week, and as a result, I showed up to the Mallorca 312 in the best shape I\\u2019ve ever been in.\\u201d</blockquote><figcaption><b>Ward Den Hollander</b><span>Dublin, Ireland</span></figcaption></figure><figure class=\\\"rv\\\"><div class=\\\"rv-tag\\\">PB FTP in 7 weeks</div><blockquote>\\u201cAfter 7 weeks of following his programme, which is mainly working in Z1/2 with bits of Z3, I\\u2019ve managed to get a PB FTP of 207W.\\u201d</blockquote><figcaption><b>Lisa Dunne</b><span>Al Jassra Race Team, Qatar</span></figcaption></figure><figure class=\\\"rv\\\"><div class=\\\"rv-tag\\\">+40 W FTP, +300 W sprint</div><blockquote>\\u201cMatteo managed to raise my FTP from 220w to 260w in less than 4 months &amp; my sprint from 600w ish to 920w.\\u201d</blockquote><figcaption><b>Shane Courtney</b><span>Tralee Manor West ibike</span></figcaption></figure><figure class=\\\"rv\\\"><div class=\\\"rv-tag\\\">All-time power PBs, around family and work</div><blockquote>\\u201cMatteo Cigala has been an incredible cycling coach, helping me navigate training around my family and work commitments. Thanks to his guidance, I not only reached my targets but also hit all-time personal best power numbers.\\u201d</blockquote><figcaption><b>John Dowley</b><span>Carrick-on-Suir, Ireland</span></figcaption></figure><figure class=\\\"rv\\\"><div class=\\\"rv-tag\\\">From A3 to A1 and the R\\u00e1s</div><blockquote>\\u201cI commenced the cycling season in February as an A2 and by March I had gained my first points finishing 2nd in the Lucan GP. Finally last week I achieved one of my goals for the season: I won the Connor Coombes GP.\\u201d</blockquote><figcaption><b>Gerard Dunne</b><span>Navan Road Club</span></figcaption></figure><figure class=\\\"rv\\\"><div class=\\\"rv-tag\\\">16 kg lighter, fitter and happier</div><blockquote>\\u201cTo date I\\u2019ve lost close to 16 kg thanks to Matteos coaching and support, most importantly I look forward to every session that is planned out for me.\\u201d</blockquote><figcaption><b>Rob Kavanagh</b><span>Ireland</span></figcaption></figure></div><div class=\\\"rv-nav\\\"><button type=\\\"button\\\" class=\\\"rv-btn\\\" data-d=\\\"-1\\\" aria-label=\\\"Previous reviews\\\">\\u2190</button><button type=\\\"button\\\" class=\\\"rv-btn\\\" data-d=\\\"1\\\" aria-label=\\\"Next reviews\\\">\\u2192</button></div></div>\\n  </div>\\n</section></div>\"}, \"elements\": [], \"isInner\": false}], \"isInner\": false}, {\"id\": \"d1cc53e\", \"elType\": \"container\", \"settings\": {\"content_width\": \"full\", \"css_classes\": \"cc-wrap\", \"padding\": {\"unit\": \"px\", \"top\": \"0\", \"right\": \"0\", \"bottom\": \"0\", \"left\": \"0\", \"isLinked\": true}, \"flex_gap\": {\"unit\": \"px\", \"size\": 0, \"column\": \"0\", \"row\": \"0\"}}, \"elements\": [{\"id\": \"2fc48c4\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<div class=\\\"cc cc-page\\\"><section>\\n  <div class=\\\"in\\\">\\n    <div class=\\\"head\\\"><div><div class=\\\"eyebrow\\\">Press &amp; partners</div><h2>AS SEEN IN</h2><div class=\\\"bar\\\"></div></div></div>\\n    <div class=\\\"logos seen\\\"><span><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-red-bull.webp\\\" alt=\\\"Red Bull Racing logo | Cigala Cycling Coaching\\\" loading=\\\"lazy\\\"></span><span><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-stickybottle.webp\\\" alt=\\\"StickyBottle.com cycling logo | Cigala Cycling Coaching\\\" loading=\\\"lazy\\\"></span><span><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-zwift.webp\\\" alt=\\\"White Zwift logo on orange bg | Cigala Cycling Coaching\\\" loading=\\\"lazy\\\"></span><span><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-trainingpeaks.webp\\\" alt=\\\"TrainingPeaks logo with icon | Cigala Cycling Coaching\\\" loading=\\\"lazy\\\"></span><span><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-cycling-ireland.webp\\\" alt=\\\"Cycling Ireland logo | Cigala Cycling Coaching\\\" loading=\\\"lazy\\\"></span><span><img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-vekta.webp\\\" alt=\\\"Vekta logo with yellow icon | Cigala Cycling Coaching\\\" loading=\\\"lazy\\\"></span></div>\\n  </div>\\n</section></div>\"}, \"elements\": [], \"isInner\": false}], \"isInner\": false}, {\"id\": \"1c893f1\", \"elType\": \"container\", \"settings\": {\"content_width\": \"full\", \"css_classes\": \"cc-wrap\", \"padding\": {\"unit\": \"px\", \"top\": \"0\", \"right\": \"0\", \"bottom\": \"0\", \"left\": \"0\", \"isLinked\": true}, \"flex_gap\": {\"unit\": \"px\", \"size\": 0, \"column\": \"0\", \"row\": \"0\"}}, \"elements\": [{\"id\": \"5fe046d\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<div class=\\\"cc cc-page\\\"><section>\\n  <div class=\\\"in\\\">\\n    <div class=\\\"band band-cta\\\">\\n      <img src=\\\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-cta.webp\\\" alt=\\\"Cyclists riding below the Tre Cime di Lavaredo peaks\\\" loading=\\\"lazy\\\" width=\\\"1367\\\" height=\\\"1492\\\">\\n      <div class=\\\"tx\\\">\\n        <h3 class=\\\"h-sec\\\">START WORKING WITH MATTEO</h3>\\n        <div class=\\\"bar\\\"></div>\\n        <p class=\\\"lede\\\">Choose a coaching package, or get in touch and we'll help you find the right one.</p>\\n        <div class=\\\"ctas\\\"><a class=\\\"btn btn-go\\\" href=\\\"/individual-packages/\\\">Find your package \\u2192</a><a class=\\\"btn btn-ghost\\\" href=\\\"/contact/\\\">Contact us</a></div>\\n      </div>\\n    </div>\\n  </div>\\n</section></div>\"}, \"elements\": [], \"isInner\": false}, {\"id\": \"8fbefe3\", \"elType\": \"widget\", \"widgetType\": \"html\", \"settings\": {\"html\": \"<script>(function(){var r=document.getElementById('rv-row');if(!r)return;document.querySelectorAll('.rv-btn').forEach(function(b){b.addEventListener('click',function(){r.scrollBy({left:(+b.dataset.d)*r.clientWidth*0.85,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});});});})();</script>\"}, \"elements\": [], \"isInner\": false}], \"isInner\": false}]", "_elementor_edit_mode": "builder", "_elementor_template_type": "wp-page"}, "content": "<div class=\"cc cc-page\"><div class=\"hero\">\n  <img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-hero.webp\" alt=\"Four Cigala Cycling riders climbing together in team kit\" width=\"1600\" height=\"1082\">\n  <div class=\"in\">\n    <h2 class=\"eyebrow-h\">#TrainSmarterRideFaster</h2>\n    <h1>Premium Cycling &amp; Triathlon Coaching</h1>\n    <p class=\"lede\">Personalised training plans, expert feedback and support from Head Coach Matteo Cigala, on TrainingPeaks and Vekta.</p>\n    <div class=\"ctas\">\n      <a class=\"btn btn-go\" href=\"/individual-packages/\">Cycling coaching \u2192</a>\n      <a class=\"btn btn-ghost\" href=\"/tri-individual-packages/\">Triathlon coaching</a>\n    </div>\n  </div>\n</div></div>\n<div class=\"cc cc-page\"><div class=\"in stats-wrap\">\n  <div class=\"stats\">\n    <div class=\"stat\"><div class=\"n\">28</div><div class=\"l\">Years of racing</div></div>\n    <div class=\"stat\"><div class=\"n\">200+</div><div class=\"l\">Race victories</div></div>\n    <div class=\"stat\"><div class=\"n\">1-to-1</div><div class=\"l\">Sessions in Wicklow</div></div>\n    <div class=\"stat\"><div class=\"n\">Worldwide</div><div class=\"l\">Remote coaching</div></div>\n  </div>\n</div></div>\n<div class=\"cc cc-page\"><section id=\"coaching\">\n  <div class=\"in\">\n    <div class=\"head\"><div>\n      <div class=\"eyebrow\">Cycling &amp; triathlon</div>\n      <h2>ITALIAN PERFORMANCE COACHING FOR CYCLISTS AND TRIATHLETES WORLDWIDE</h2>\n      <div class=\"bar\"></div>\n      <p class=\"lede\">Personalised coaching from Italian Head Coach Matteo Cigala, combining over 20 years of racing experience, sports science, and professional coaching methods to help cyclists and triathletes in Ireland and worldwide improve performance and reach their goals.</p>\n    </div></div>\n    <div class=\"paths\">\n      <a class=\"path\" href=\"/individual-packages/\">\n        <img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-cycling-coaching.webp\" alt=\"Cyclist riding a quiet country road\" loading=\"lazy\" width=\"1067\" height=\"1600\">\n        <div class=\"tx\"><h3>CYCLING COACHING</h3><p>Road, gravel and Gran Fondo. Individual, group and club packages.</p><span class=\"go\">View cycling packages \u2192</span></div>\n      </a>\n      <a class=\"path\" href=\"/tri-individual-packages/\">\n        <img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-triathlon-coaching.webp\" alt=\"Triathlete standing by a lake at sunrise\" loading=\"lazy\" width=\"1600\" height=\"1200\">\n        <div class=\"tx\"><h3>triathlon COACHING</h3><p>Swim, bike and run, from Sprint to Ironman.</p><span class=\"go\">View triathlon packages \u2192</span></div>\n      </a>\n    </div>\n  </div>\n</section></div>\n<div class=\"cc cc-page\"><section class=\"offer\">\n  <div class=\"in split\">\n    <div class=\"photo\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-what-we-offer.webp\" alt=\"Cyclist finishing the Gran Fondo Strade Bianche in Siena\" loading=\"lazy\" width=\"1600\" height=\"1066\"></div>\n    <div>\n      <div class=\"eyebrow\">Why Cigala Cycling</div>\n      <h3 class=\"h-sec\">WHAT WE OFFER</h3>\n      <div class=\"bar\"></div>\n      <p class=\"first\">Cigala Cycling provides premium cycling and triathlon coaching for all levels of cyclist, from leisure to professional.<br>\nNo matter where you are in the world, we coach remotely in different countries, developing customised coaching plans to suit your needs.</p>\n      <p>Cigala Cycling was founded by Italian Head Coach Matteo Cigala, that with over 20 years experience in cycling, hundreds of victories in his name and a Diploma in Science and Sport, had a vision of connecting Ireland to the Italian cycling scene, bringing the most advanced and up-to date coaching through his continuous collaboration with Italian professional cyclists and coaches.</p>\n      <p>With Cigala Cycling Tours we also hold Bike Tours all over Europe such as Lake Garda in Italy, the Algarve in Portugal and in the Italian Alps, French Alps, Pyrenees, Croatia and much more</p>\n      <div class=\"ctas\"><a class=\"btn btn-ghost\" href=\"/coaching-vision/\">Our coaching vision \u2192</a></div>\n    </div>\n  </div>\n</section></div>\n<div class=\"cc cc-page\"><section class=\"matteo\">\n  <div class=\"in split flip\">\n    <div>\n      <div class=\"eyebrow\">Meet your coach</div>\n      <h3 class=\"h-sec\">MATTEO CIGALA</h3>\n      <div class=\"bar\"></div>\n      <p class=\"role\">Head Coach &amp; Tours Director \u00b7 28 years in cycling</p>\n      <ul class=\"creds\">\n        <li>European Road Champion Gran Fondo</li>\n        <li>UCI Gran Fondo Vice World Champion</li>\n        <li>UCI Gravel Vice World Champion</li>\n        <li>Italian Gravel Champion</li>\n      </ul>\n      <div class=\"ctas\"><a class=\"btn btn-ghost\" href=\"/about/\">About Matteo \u2192</a><a class=\"arrow-link\" href=\"/testimonials/\">Read our testimonials \u2192</a></div>\n    </div>\n    <div class=\"photo\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-matteo.webp\" alt=\"Matteo Cigala, Head Coach, in the white Cigala Cycling jersey\" loading=\"lazy\"></div>\n  </div>\n</section></div>\n<div class=\"cc cc-page\"><section id=\"tours\">\n  <div class=\"in\">\n    <div class=\"head\">\n      <div>\n        <div class=\"eyebrow\">Ride with us</div>\n        <h3 class=\"h-sec\">CYCLING TOURS</h3>\n        <div class=\"bar\"></div>\n        <p class=\"lede\">With the partner company, Cigala Cycling Tours, we have selected the most beautiful cycling locations in Europe with a rich heritage, local culture and cuisine and combined them with amazing cycling routes to ensure that your vacation will be truly unforgettable.</p>\n      </div>\n      <a class=\"arrow-link\" href=\"https://tours.cigalacycling.com/\" target=\"_blank\" rel=\"noopener\">Visit Cigala Cycling Tours \u2192</a>\n    </div>\n    <div class=\"dests\">\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/algarve/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-algarve.webp\" alt=\"Cycling in The Algarve, Portugal\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">THE Algarve, PORTUGAL</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/lake-garda/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-lake-garda.webp\" alt=\"Cycling in Lake Garda, Italy\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">LAKE GARDA, ITALY</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/alps-dolomites/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-italian-alps.webp\" alt=\"Cycling in Italian Alps\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">ITALIAN ALPS</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/alps-dolomites/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-dolomites.webp\" alt=\"Cycling in Dolomites, Italy\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">DOLOMITES, ITALY</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/lake-como/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-lake-como.webp\" alt=\"Cycling in Lake Como, Italy\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">LAKE COMO, ITALY</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/tuscany/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-tuscany.webp\" alt=\"Cycling in Tuscany, Italy\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">TUSCANY, ITALY</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/puglia/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-puglia.webp\" alt=\"Cycling in Puglia, Italy\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">PUGLIA, ITALY</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/sicily/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-sicily.webp\" alt=\"Cycling in Sicily, Italy\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">SICILY, ITALY</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/french-alps/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-french-alps.webp\" alt=\"Cycling in French Alps, France\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">FRENCH ALPS, FRANCE</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/mallorca/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-balearic-islands.webp\" alt=\"Cycling in Balearic Islands, Spain\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">BALEARIC ISLANDS, SPAIN</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/costa-blanca/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-costa-blanca.webp\" alt=\"Cycling in Costa Blanca, Spain\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">COSTA BLANCA, SPAIN</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/slovenia/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-slovenia.webp\" alt=\"Cycling in Slovenia\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">SLOVENIA</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/cyprus/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-cyprus.webp\" alt=\"Cycling in Cyprus\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">CYPRUS</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/croatia/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-croatia.webp\" alt=\"Cycling in Croatia\" loading=\"lazy\" width=\"400\" height=\"300\"><h4 class=\"dest-h\">CROATIA</h4></a>\n      <a class=\"dest\" href=\"https://tours.cigalacycling.com/destinations/ireland/\" target=\"_blank\" rel=\"noopener\"><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-dest-ireland.webp\" alt=\"Cycling in Ireland\" loading=\"lazy\" width=\"400\" height=\"300\"><h2 class=\"dest-h\">IRELAND</h2></a>\n    </div>\n  </div>\n</section></div>\n<div class=\"cc cc-page\"><section>\n  <div class=\"in\">\n    <div class=\"band\">\n      <img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-retail.webp\" alt=\"Cyclist training on an indoor smart trainer in a garage\" loading=\"lazy\" width=\"1600\" height=\"872\">\n      <div class=\"tx\">\n        <div class=\"eyebrow eb-pill\"><span></span>Cigala Cycling Retail</div>\n        <h2>SUPPLIERS OF PREMIUM BRANDS</h2>\n        <div class=\"bar\"></div>\n        <div class=\"ctas\"><h3 class=\"btn-h\"><a class=\"btn btn-go\" href=\"https://retail.cigalacycling.com/\" target=\"_blank\" rel=\"noopener\">VISIT OUR RETAIL SITE</a></h3></div>\n      </div>\n    </div>\n  </div>\n</section></div>\n<div class=\"cc cc-page\"><section>\n  <div class=\"in decade\">\n    <img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-over-a-decade.webp\" alt=\"Over a decade of dedication, expertise and results: athletes coached by Cigala Cycling\" loading=\"lazy\" width=\"1000\" height=\"562\">\n  </div>\n</section></div>\n<div class=\"cc cc-page\"><section id=\"reviews\">\n  <div class=\"in\">\n    <div class=\"head\">\n      <div><div class=\"eyebrow\">Our athletes</div><h3 class=\"h-sec\">WHAT OUR ATHLETES SAY</h3><div class=\"bar\"></div></div>\n      <div class=\"rv-links\"><a class=\"arrow-link\" href=\"https://share.google/lwboSfcuStGhX0c0p\" target=\"_blank\" rel=\"noopener\">\u2605 Read our reviews on Google \u2192</a><a class=\"arrow-link\" href=\"/testimonials/\">All testimonials \u2192</a></div>\n    </div>\n    <div class=\"rv-wrap\"><div class=\"rv-row\" id=\"rv-row\" tabindex=\"0\" aria-label=\"Athlete reviews, scroll sideways\"><figure class=\"rv\"><div class=\"rv-tag\">Gran Fondo Worlds qualifier</div><blockquote>\u201cWith his expertise, support, and personalized approach, I have achieved my goal of qualifying for the UCI Granfondo World Championship.\u201d</blockquote><figcaption><b>Bernd Ondruch</b><span>Germany</span></figcaption></figure><figure class=\"rv\"><div class=\"rv-tag\">From couch to Haute Route, and back after heart disease</div><blockquote>\u201cFirst time was a 9 month training plan to get me from couch (literally!) to Haute Route Pyrenees in 2017 to mark my 60th birthday. More recently, I have worked with Matteo to help me recover from heart disease and a cardiac procedure.\u201d</blockquote><figcaption><b>Derek Lawler</b><span>Kilkenny, Ireland</span></figcaption></figure><figure class=\"rv\"><div class=\"rv-tag\">Mallorca 312 in the best shape ever</div><blockquote>\u201cI truly had a tailor-made plan every single week, and as a result, I showed up to the Mallorca 312 in the best shape I\u2019ve ever been in.\u201d</blockquote><figcaption><b>Ward Den Hollander</b><span>Dublin, Ireland</span></figcaption></figure><figure class=\"rv\"><div class=\"rv-tag\">PB FTP in 7 weeks</div><blockquote>\u201cAfter 7 weeks of following his programme, which is mainly working in Z1/2 with bits of Z3, I\u2019ve managed to get a PB FTP of 207W.\u201d</blockquote><figcaption><b>Lisa Dunne</b><span>Al Jassra Race Team, Qatar</span></figcaption></figure><figure class=\"rv\"><div class=\"rv-tag\">+40 W FTP, +300 W sprint</div><blockquote>\u201cMatteo managed to raise my FTP from 220w to 260w in less than 4 months &amp; my sprint from 600w ish to 920w.\u201d</blockquote><figcaption><b>Shane Courtney</b><span>Tralee Manor West ibike</span></figcaption></figure><figure class=\"rv\"><div class=\"rv-tag\">All-time power PBs, around family and work</div><blockquote>\u201cMatteo Cigala has been an incredible cycling coach, helping me navigate training around my family and work commitments. Thanks to his guidance, I not only reached my targets but also hit all-time personal best power numbers.\u201d</blockquote><figcaption><b>John Dowley</b><span>Carrick-on-Suir, Ireland</span></figcaption></figure><figure class=\"rv\"><div class=\"rv-tag\">From A3 to A1 and the R\u00e1s</div><blockquote>\u201cI commenced the cycling season in February as an A2 and by March I had gained my first points finishing 2nd in the Lucan GP. Finally last week I achieved one of my goals for the season: I won the Connor Coombes GP.\u201d</blockquote><figcaption><b>Gerard Dunne</b><span>Navan Road Club</span></figcaption></figure><figure class=\"rv\"><div class=\"rv-tag\">16 kg lighter, fitter and happier</div><blockquote>\u201cTo date I\u2019ve lost close to 16 kg thanks to Matteos coaching and support, most importantly I look forward to every session that is planned out for me.\u201d</blockquote><figcaption><b>Rob Kavanagh</b><span>Ireland</span></figcaption></figure></div><div class=\"rv-nav\"><button type=\"button\" class=\"rv-btn\" data-d=\"-1\" aria-label=\"Previous reviews\">\u2190</button><button type=\"button\" class=\"rv-btn\" data-d=\"1\" aria-label=\"Next reviews\">\u2192</button></div></div>\n  </div>\n</section></div>\n<div class=\"cc cc-page\"><section>\n  <div class=\"in\">\n    <div class=\"head\"><div><div class=\"eyebrow\">Press &amp; partners</div><h2>AS SEEN IN</h2><div class=\"bar\"></div></div></div>\n    <div class=\"logos seen\"><span><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-red-bull.webp\" alt=\"Red Bull Racing logo | Cigala Cycling Coaching\" loading=\"lazy\"></span><span><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-stickybottle.webp\" alt=\"StickyBottle.com cycling logo | Cigala Cycling Coaching\" loading=\"lazy\"></span><span><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-zwift.webp\" alt=\"White Zwift logo on orange bg | Cigala Cycling Coaching\" loading=\"lazy\"></span><span><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-trainingpeaks.webp\" alt=\"TrainingPeaks logo with icon | Cigala Cycling Coaching\" loading=\"lazy\"></span><span><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-cycling-ireland.webp\" alt=\"Cycling Ireland logo | Cigala Cycling Coaching\" loading=\"lazy\"></span><span><img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-logo-vekta.webp\" alt=\"Vekta logo with yellow icon | Cigala Cycling Coaching\" loading=\"lazy\"></span></div>\n  </div>\n</section></div>\n<div class=\"cc cc-page\"><section>\n  <div class=\"in\">\n    <div class=\"band band-cta\">\n      <img src=\"https://staging.coaching.cigalacycling.com/wp-content/uploads/2026/11/cigala-coaching-cta.webp\" alt=\"Cyclists riding below the Tre Cime di Lavaredo peaks\" loading=\"lazy\" width=\"1367\" height=\"1492\">\n      <div class=\"tx\">\n        <h3 class=\"h-sec\">START WORKING WITH MATTEO</h3>\n        <div class=\"bar\"></div>\n        <p class=\"lede\">Choose a coaching package, or get in touch and we'll help you find the right one.</p>\n        <div class=\"ctas\"><a class=\"btn btn-go\" href=\"/individual-packages/\">Find your package \u2192</a><a class=\"btn btn-ghost\" href=\"/contact/\">Contact us</a></div>\n      </div>\n    </div>\n  </div>\n</section></div>"}